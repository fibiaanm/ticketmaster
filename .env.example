# Copiar a .env (no se versiona)
MYSQL_ROOT_PASSWORD=root
MYSQL_PASSWORD=tickets
JWT_SECRET=cambia-este-secreto-de-al-menos-32-bytes-0123456789
# Motor de busqueda: mysql | hybrid (q en OpenSearch, resto en MySQL) | opensearch (todo en OpenSearch)
SEARCH_ENGINE=hybrid
# Modo de analisis: async (cola + worker) | sync (en la misma peticion)
ANALYSIS_MODE=async
# Proveedor de IA y modelo (desacoplado): openai
AI_PROVIDER=openai
AI_MODEL=gpt-5.4-mini
AI_API_KEY=
